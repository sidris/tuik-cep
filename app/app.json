{
  "expo": {
    "name": "TUIK Cep",
    "slug": "tuik-cep",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sefa.tuikcep",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8102E",
          "defaultChannel": "tuik"
        }
      ],
      [
        "./plugins/withAndroidLabel",
        "TÜİK Cep"
      ],
      "expo-sharing"
    ],
    "extra": {
      "githubRepo": "sidris/tuik-cep",
      "eas": {
        "projectId": "ae6eb291-b0a8-40be-87e7-8c02a185cc88"
      }
    },
    "owner": "sidrisoglu"
  }
}
